FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:jackmacwindows/ppa \
    && apt-get update \
    && apt-get install -y craftos-pc \
    && rm -rf /var/lib/apt/lists/*

VOLUME /craftos-data

CMD ["craftos", "--cli", "--data-dir", "/craftos-data"]